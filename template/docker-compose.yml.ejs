<%
const projName = (name + '').split(/[\\/]/).filter(Boolean).pop() || 'app';
let svc = projName.toLowerCase().replace(/[^a-z0-9_.-]/g, '-').replace(/^[^a-z0-9]+/, '');
if (!svc) { svc = 'app'; }
const hasTsNode = Array.isArray(libs) && libs.indexOf('ts-node') > -1;
-%>
# Docker Compose configuration for <%- projName %> (generated by create-ts-next).
#
#   docker compose up --build      # build the image and start the service
#   docker compose run --rm app sh # open a shell inside the container
#   docker compose down            # stop and remove the container
services:
  app:
    container_name: <%- svc %>
    build:
      context: .
      dockerfile: Dockerfile
      # Build the lean runtime image by default. Switch to `development` for the
      # full toolchain (see the commented block below).
      target: production
    environment:
      NODE_ENV: production
    # Run as PID 1 with an init so signals (Ctrl+C) are forwarded correctly.
    init: true
    # The starter entrypoint runs once and exits. Add a long-running server
    # before enabling a restart policy:
    # restart: unless-stopped
    ports:
      - "3000:3000"
    # --- Local development -----------------------------------------------------
    # Change `target` above to `development`, then uncomment the block below to

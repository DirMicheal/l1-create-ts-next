# =============================================================================
# Development stage — includes dev dependencies and ts-node for local dev
# Usage:  docker build --target development -t <%= name %>:dev .
#         docker run --rm -it -v $(pwd)/src:/app/src -p 3000:3000 <%= name %>:dev
# =============================================================================
FROM node:20-alpine AS development
WORKDIR /app

# Install ALL dependencies (dev + production) for ts-node development
COPY package*.json ./
RUN npm ci \
    && npm cache clean --force

# Copy TypeScript config and source code
COPY tsconfig.json ./
COPY src/ ./src/

EXPOSE 3000

CMD ["npx", "ts-node", "src/index.ts"]

# =============================================================================
# Builder stage — compile TypeScript to JavaScript
# =============================================================================
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci \
    && npm cache clean --force

COPY tsconfig.json ./
COPY src/ ./src/

# Compile TypeScript — output goes to dist/
RUN npm run build

# =============================================================================
# Production stage — minimal image with only compiled output + prod deps
# Usage:  docker build -t <%= name %>:latest .
#         docker run --rm -p 3000:3000 <%= name %>:latest
# =============================================================================
FROM node:20-alpine AS production
WORKDIR /app

# Install production dependencies only (smaller layer)
COPY package*.json ./
RUN npm ci --only=production \
    && npm cache clean --force

# Copy compiled output from builder stage
COPY --from=builder /app/dist ./dist/

# Run as non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && chown -R appuser:appgroup /app
USER appuser

EXPOSE 3000

CMD ["node", "dist/index.js"]

<%
const pm = (packageManager || 'npm') + '';
const projName = (name + '').split(/[\\/]/).filter(Boolean).pop() || 'app';
const hasTsNode = Array.isArray(libs) && libs.indexOf('ts-node') > -1;
const installAll =
  pm === 'yarn' ? 'yarn install'
  : pm === 'pnpm' ? 'pnpm install'
  : 'npm install';
const installProd =
  pm === 'yarn' ? 'yarn install --production && yarn cache clean'
  : pm === 'pnpm' ? 'pnpm install --prod && pnpm store prune'
  : 'npm install --omit=dev && npm cache clean --force';
const devCmd =
  pm === 'yarn' ? '["yarn", "dev:start"]'
  : pm === 'pnpm' ? '["pnpm", "run", "dev:start"]'
  : '["npm", "run", "dev:start"]';
-%>
# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for <%- projName %> (generated by create-ts-next).
#
#   Build the default (production) image:   docker build -t <%- projName %> .
#   Run it:                                 docker run --rm <%- projName %>
#   Build the development image:            docker build --target development -t <%- projName %>-dev .
#
# Pin the Node.js major version here. Alpine keeps the image small.
ARG NODE_VERSION=20

###############################################################################
# base — shared foundation: workdir + package manifests only (better caching)
###############################################################################
FROM node:${NODE_VERSION}-alpine AS base
WORKDIR /app
<% if (pm === 'pnpm') { -%>
# Enable the bundled pnpm via corepack (ships with the Node image).
RUN corepack enable
<% } -%>
# Copy only the manifests first so dependency layers are cached until they change.
COPY package.json tsconfig.json ./

###############################################################################
# deps — install ALL dependencies (incl. dev) for building and development
###############################################################################
FROM base AS deps
RUN <%- installAll %>

###############################################################################
# build — compile TypeScript (src -> dist) using the always-present tsc.
# We call tsc directly (not the package "build" script) so the image build is
# not coupled to lint/test passing.
###############################################################################
FROM deps AS build
ENV NODE_ENV=production
COPY src ./src
RUN npx tsc

###############################################################################
# development — full toolchain, source mounted/copied, hot entrypoint.
###############################################################################
FROM deps AS development
ENV NODE_ENV=development
COPY . .
EXPOSE 3000
<% if (hasTsNode) { -%>
# ts-node is installed, run the sources directly (good for `docker compose` with a bind mount).
CMD <%- devCmd %>
<% } else { -%>
# ts-node was not selected for this project; compile once, then run the output.
RUN npx tsc
CMD ["node", "dist/index.js"]
<% } -%>

###############################################################################
# production — minimal runtime image: prod deps + compiled output only.
###############################################################################
FROM node:${NODE_VERSION}-alpine AS production
ENV NODE_ENV=production
WORKDIR /app
<% if (pm === 'pnpm') { -%>
RUN corepack enable
<% } -%>
# Install runtime dependencies only (keeps the final image lean).
COPY package.json ./
RUN <%- installProd %>
# Bring in the compiled JavaScript from the build stage.
COPY --from=build /app/dist ./dist
# Drop root privileges for runtime.
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]

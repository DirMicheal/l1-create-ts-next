<% const projName = (name + '').split(/[\\/]/).filter(Boolean).pop() || 'app'; -%>
# .dockerignore for <%- projName %> — keeps the build context small and the
# image lean by excluding host-only artifacts, secrets and VCS metadata.

# Dependencies (re-installed inside the image)
node_modules
jspm_packages
.pnp.*
.yarn/cache
.yarn/unplugged

# Build output (re-compiled inside the image)
dist
build
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & secrets
.env
.env.*

# Version control
.git
.gitignore
.gitattributes

# Editors / IDE
.idea
.vscode
*.swp

# OS files
.DS_Store
Thumbs.db

# Tests & coverage
coverage
.nyc_output

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
